{
  "name": "dsh_desktop",
  "version": "1.0.3",
  "private": true,
  "description": "DeepSeek Harness Desktop",
  "main": "src/main.js",
  "author": "Local desktop shell",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/service-manager.js && node --check src/runtime-manager.js && node --check src/windows-integration.js && node --check scripts/smoke-managed-runtime.js && node --check scripts/smoke-managed-service.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop.shell",
    "productName": "DeepSeek Harness Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/app.ico",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bootstrap",
        "to": "bootstrap",
        "filter": [
          "package.json",
          "package-lock.json"
        ]
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DeepSeek Harness Desktop Portable.exe"
    },
    "nsis": {
      "artifactName": "DeepSeek Harness Desktop Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
